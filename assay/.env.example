# Required for `assay run`, `probe`, `watch`, and live catalog in `serve`/`estimate`.
ORBIO_API_KEY=

# Optional. Defaults to https://api.orbio.so/api/v1
# (the agent paper also shows https://www.orbio.so/api/v1)
# ORBIO_BASE_URL=https://api.orbio.so/api/v1

# Optional baseline: a direct OpenRouter key enables the independent latency A/B
# and the direct-to-provider tokenizer fingerprint comparison.
# ASSAY_BASELINE_KEY=
# ASSAY_BASELINE_URL=https://openrouter.ai/api/v1

# Optional overrides
# ASSAY_MAX_SPEND_USD=0.25
# ASSAY_MODELS=anthropic/claude-sonnet-5,openai/gpt-6-astra
# ASSAY_DIR=.assay
